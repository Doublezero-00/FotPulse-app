<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/backgroundColor"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Info"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/textColor" android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/tvUsernameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="18sp"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/textColor" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading username..."
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="4dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/textColor" android:background="@drawable/underline_text_view" />

    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="18sp"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/textColor" /> <TextView
    android:id="@+id/tvEmail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Loading email..."
    android:textSize="20sp"
    android:textStyle="bold"
    android:padding="4dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="48dp"
    android:textColor="@color/textColor" android:background="@drawable/underline_text_view" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center">

        <Button
            android:id="@+id/btnEditInfo"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:text="Edit Info"
            app:backgroundTint="@color/primaryColor" android:textColor="@color/backgroundColor"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="140dp"
            android:layout_height="48dp"
            app:backgroundTint="@color/primaryColor" android:textColor="@color/backgroundColor"
            android:text="Sign Out" />
    </LinearLayout>

</LinearLayout>